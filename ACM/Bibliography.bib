@article{kim_what_2024,
    title = {What {Makes} {People} {Feel} {Empathy} for {AI} {Chatbots}? {Assessing} the {Role} of {Competence} and {Warmth}},
    volume = {40},
    issn = {1044-7318},
    shorttitle = {What {Makes} {People} {Feel} {Empathy} for {AI} {Chatbots}?},
    url = {https://doi.org/10.1080/10447318.2023.2219961},
    doi = {10.1080/10447318.2023.2219961},
    abstract = {With the growth of contactless shopping, artificial intelligence (AI) chatbot services have become an effective tool for brands to interact with consumers. We investigate the effects of AI chatbots’ humanlike characteristics on consumers’ acceptance of chatbot services by mediating competence, warmth, and empathy based on the AI device use acceptance (AIDUA) model. Using structural equation modeling, we tested how the relationship between these variables differs depending on one’s need for human interaction. Findings suggest that AI chatbots’ personalization and anthropomorphism significantly increase perceived competence and warmth, leading to empathy. This positively affects consumers’ willingness to use AI chatbots. Consumers’ need for interaction moderates the relationship between anthropomorphism and competence. We applied a valid theoretical model to explore how the humanlike characteristics of AI chatbots affect consumers’ cognitive and emotional reactions, determining their service acceptance. The findings have practical value for online retailers who use AI chatbots as marketing communication tools.},
    number = {17},
    urldate = {2025-12-22},
    journal = {International Journal of Human–Computer Interaction},
    author = {Kim, Woo Bin and Hur, Hee Jin},
    month = sep,
    year = {2024},
    note = {Publisher: Taylor \& Francis
\_eprint: https://doi.org/10.1080/10447318.2023.2219961},
    keywords = {AI chatbots, empathy, humanlike AI characteristics, need for human interaction, perception, service acceptance},
    pages = {4674--4687},
}
